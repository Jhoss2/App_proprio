{"h": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>Ninja's Corp \u2014 Param\u00e8tres</title>\n<style>\n  :root{--orange:#ff7a1a;--cyan:#00f2ff;--bg:#020810;--dark:#0a1525;--border:rgba(255,122,26,.3);}\n  *{margin:0;padding:0;box-sizing:border-box;}\n  body{background:var(--bg);color:#e8d8c0;font-family:'Share Tech Mono',monospace;height:100vh;display:flex;flex-direction:column;overflow:hidden;}\n  .header{display:flex;align-items:center;padding:10px 16px;border-bottom:1px solid var(--border);background:rgba(0,0,0,.8);gap:12px;flex-shrink:0;}\n  .back-btn{background:none;border:1px solid var(--orange);color:var(--orange);padding:6px 14px;font-family:inherit;font-size:14px;cursor:pointer;border-radius:2px;}\n  .header-title{flex:1;font-size:16px;font-weight:900;letter-spacing:2px;color:var(--orange);}\n  .save-badge{font-size:10px;color:var(--cyan);opacity:0;transition:.3s;}\n  .save-badge.show{opacity:1;}\n  .scroll{flex:1;overflow-y:auto;overflow-x:hidden;padding:12px 16px 40px;}\n  .scroll::-webkit-scrollbar{width:4px;}\n  .scroll::-webkit-scrollbar-thumb{background:var(--border);}\n  .section{margin-bottom:10px;border:1px solid var(--border);border-radius:3px;background:var(--dark);overflow:hidden;}\n  .section-header{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;cursor:pointer;border-bottom:1px solid transparent;}\n  .section-header.open{border-bottom-color:var(--border);}\n  .section-title{font-size:13px;font-weight:900;letter-spacing:1px;color:var(--orange);}\n  .section-arrow{color:var(--orange);font-size:18px;transition:transform .2s;}\n  .section-arrow.open{transform:rotate(90deg);}\n  .section-body{padding:14px 16px;display:none;}\n  .section-body.open{display:block;}\n  .field{margin-bottom:14px;}\n  .field label{display:block;font-size:11px;color:#667788;margin-bottom:5px;letter-spacing:.5px;}\n  .field input,.field textarea,.field select{width:100%;background:#050e1a;color:#e8d8c0;border:1px solid var(--border);border-radius:2px;padding:9px 10px;font-family:inherit;font-size:13px;outline:none;}\n  .field input:focus,.field textarea:focus{border-color:var(--orange);}\n  .field textarea{height:70px;resize:none;}\n  .btn{display:block;width:100%;border:1px solid var(--orange);background:none;color:var(--orange);padding:10px;font-family:inherit;font-size:13px;font-weight:900;cursor:pointer;border-radius:2px;margin-top:10px;letter-spacing:.5px;}\n  .btn:hover{background:rgba(255,122,26,.1);}\n  .btn.cyan{border-color:var(--cyan);color:var(--cyan);}\n  .btn.cyan:hover{background:rgba(0,242,255,.08);}\n  .record-list{margin-top:10px;}\n  .record-item{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border:1px solid var(--border);border-radius:2px;margin-bottom:5px;background:rgba(0,0,0,.3);}\n  .record-name{font-size:12px;color:#e8d8c0;font-weight:900;}\n  .record-id{font-size:10px;color:#667788;}\n  .record-stats{font-size:10px;color:var(--cyan);margin-top:2px;}\n  .record-del{background:none;border:none;color:rgba(255,50,0,.6);font-size:14px;cursor:pointer;padding:2px 8px;}\n  .record-del:hover{color:#ff5533;}\n  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(0,242,255,.15);border:1px solid var(--cyan);color:var(--cyan);padding:8px 20px;font-family:inherit;font-size:12px;border-radius:2px;opacity:0;transition:.3s;pointer-events:none;z-index:999;}\n  .toast.show{opacity:1;}\n  .hint{font-size:10px;color:#667788;line-height:1.5;margin-bottom:10px;}\n  .divider{border:none;border-top:1px solid var(--border);margin:10px 0;}\n  .status-line{font-size:10px;color:#556677;text-align:center;padding:6px;}\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <button class=\"back-btn\" onclick=\"window._nav('dashboard.html')\">\u2039 Dashboard</button>\n  <div class=\"header-title\">\u2699 PARAM\u00c8TRES</div>\n  <div class=\"save-badge\" id=\"save-badge\">\u2713 Sauvegard\u00e9</div>\n</div>\n\n<div class=\"scroll\">\n\n  <div class=\"section\">\n    <div class=\"section-header open\" onclick=\"toggle(this)\">\n      <span class=\"section-title\">OBJECTIFS FINANCIERS</span>\n      <span class=\"section-arrow open\">\u203a</span>\n    </div>\n    <div class=\"section-body open\">\n      <div class=\"field\"><label>Objectif Financier Annuel \u2014 AFG (FCFA)</label>\n        <input type=\"number\" id=\"afg\" placeholder=\"Ex: 18000000\"></div>\n      <div class=\"field\"><label>Objectif Financier Mensuel \u2014 MFG (FCFA)</label>\n        <input type=\"number\" id=\"mfg\" placeholder=\"Ex: 1500000\"></div>\n      <div class=\"field\"><label>Premier jour de l'ann\u00e9e (r\u00e9f\u00e9rence calcul annuel)</label>\n        <input type=\"date\" id=\"fiscal-start\"></div>\n      <div class=\"hint\">Le pourcentage d'\u00e9volution annuelle (cadran \"100%\") = somme du C.A. de tous les chariots depuis cette date, divis\u00e9e par l'AFG.</div>\n      <button class=\"btn cyan\" onclick=\"saveGoals()\">\ud83d\udcbe Sauvegarder les objectifs</button>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"section-header\" onclick=\"toggle(this)\">\n      <span class=\"section-title\">GESTION DES CHARIOTS</span>\n      <span class=\"section-arrow\">\u203a</span>\n    </div>\n    <div class=\"section-body\">\n      <div class=\"hint\">L'identifiant doit \u00eatre EXACTEMENT le m\u00eame que celui configur\u00e9 dans l'application Ninja's Fries de la tablette du chariot (Panneau Admin \u2192 Identifiant Cart).</div>\n      <div class=\"field\"><label>Nom du chariot (affich\u00e9)</label>\n        <input type=\"text\" id=\"cart-name\" placeholder=\"Ex: CART 01\"></div>\n      <div class=\"field\"><label>Identifiant du chariot (cart_id)</label>\n        <input type=\"text\" id=\"cart-id\" placeholder=\"Ex: cart_01\"></div>\n      <div class=\"field\"><label>Objectif C.A. journalier (FCFA)</label>\n        <input type=\"number\" id=\"cart-ca-goal\" placeholder=\"Ex: 50000\"></div>\n      <div class=\"field\"><label>Objectif commandes journalier</label>\n        <input type=\"number\" id=\"cart-cmd-goal\" placeholder=\"Ex: 30\"></div>\n      <div class=\"field\"><label>URL vid\u00e9o mod\u00e8le 3D (mp4/webm, optionnel)</label>\n        <input type=\"url\" id=\"cart-video\" placeholder=\"https://...\"></div>\n      <button class=\"btn\" onclick=\"addCart()\">+ Ajouter / Mettre \u00e0 jour le chariot</button>\n      <hr class=\"divider\">\n      <div class=\"record-list\" id=\"carts-list\">\n        <div class=\"status-line\">Chargement...</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"section-header\" onclick=\"toggle(this)\">\n      <span class=\"section-title\">AJOUTER UN FOURNISSEUR</span>\n      <span class=\"section-arrow\">\u203a</span>\n    </div>\n    <div class=\"section-body\">\n      <div class=\"field\"><label>Nom de l'entreprise fournisseuse</label>\n        <input type=\"text\" id=\"sup-name\" placeholder=\"Ex: SARL Grossiste BF\"></div>\n      <div class=\"field\"><label>Produit</label>\n        <input type=\"text\" id=\"sup-product\" placeholder=\"Ex: Pommes de terre fra\u00eeches\"></div>\n      <div class=\"field\"><label>Sp\u00e9cifications</label>\n        <textarea id=\"sup-spec\" placeholder=\"Taille, conditionnement, vari\u00e9t\u00e9...\"></textarea></div>\n      <div class=\"field\"><label>D\u00e9lai commande \u2192 r\u00e9ception</label>\n        <input type=\"text\" id=\"sup-delay\" placeholder=\"Ex: 2-3 jours\"></div>\n      <div class=\"field\"><label>Qualit\u00e9</label>\n        <select id=\"sup-quality\">\n          <option value=\"\">S\u00e9lectionner...</option>\n          <option>Premium</option><option>Standard</option><option>\u00c9conomique</option>\n        </select></div>\n      <div class=\"field\"><label>Prix unitaire (FCFA)</label>\n        <input type=\"number\" id=\"sup-price\" placeholder=\"Ex: 500\"></div>\n      <button class=\"btn\" onclick=\"addSupplier()\">+ Ajouter le fournisseur</button>\n      <hr class=\"divider\">\n      <div class=\"record-list\" id=\"suppliers-list\">\n        <div class=\"status-line\">Chargement...</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"section-header\" onclick=\"toggle(this)\">\n      <span class=\"section-title\">R\u00c9COMPENSES & BONUS</span>\n      <span class=\"section-arrow\">\u203a</span>\n    </div>\n    <div class=\"section-body\">\n      <div class=\"field\"><label>Seuil \"Record Destroyer\" (% objectif C.A. journalier)</label>\n        <input type=\"number\" id=\"reward-soldout\" placeholder=\"Ex: 100\"></div>\n      <div class=\"field\"><label>Seuil \"Game Changer\" (% objectif commandes)</label>\n        <input type=\"number\" id=\"reward-game\" placeholder=\"Ex: 85\"></div>\n      <div class=\"field\"><label>Bonus sold-out (FCFA)</label>\n        <input type=\"number\" id=\"bonus-soldout\" placeholder=\"Ex: 5000\"></div>\n      <div class=\"field\"><label>Bonus \"Best Cart\" hebdomadaire (FCFA)</label>\n        <input type=\"number\" id=\"bonus-best\" placeholder=\"Ex: 10000\"></div>\n      <button class=\"btn cyan\" onclick=\"saveGoals()\">\ud83d\udcbe Sauvegarder</button>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"section-header\" onclick=\"toggle(this)\">\n      <span class=\"section-title\">RAPPORTS PDF</span>\n      <span class=\"section-arrow\">\u203a</span>\n    </div>\n    <div class=\"section-body\">\n      <button class=\"btn\" onclick=\"toast('\ud83d\udcc4 Export mensuel \u2014 bient\u00f4t disponible')\">\ud83d\udcc4 G\u00e9n\u00e9rer rapport mensuel</button>\n      <button class=\"btn\" onclick=\"toast('\ud83d\udcc4 Export annuel \u2014 bient\u00f4t disponible')\">\ud83d\udcc4 G\u00e9n\u00e9rer rapport annuel</button>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"section-header\" onclick=\"toggle(this)\">\n      <span class=\"section-title\">ACC\u00c8S RAPIDES</span>\n      <span class=\"section-arrow\">\u203a</span>\n    </div>\n    <div class=\"section-body\">\n      <button class=\"btn\" onclick=\"window._nav('live.html')\">\ud83d\udce1 Surveillance Live (toutes cam\u00e9ras)</button>\n      <button class=\"btn\" onclick=\"window._nav('recompenses.html')\">\ud83c\udfc6 Tableau de r\u00e9compenses</button>\n      <button class=\"btn\" onclick=\"window._nav('stocks.html')\">\ud83d\udce6 Gestion des stocks</button>\n      <button class=\"btn\" onclick=\"window._nav('lumi.html')\">\ud83e\udd16 Lumi \u2014 Assistant IA</button>\n    </div>\n  </div>\n\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\nconst FIREBASE_CONFIG = {\n  apiKey:\"AIzaSyDJS5sgI7rFyAQAOZNgJsZ1nkWwjFI-cDE\",\n  projectId:\"ninja-s-fries\",\n};\nlet db, fs;\n\nasync function init() {\n  try {\n    const { initializeApp } = await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js');\n    fs = await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js');\n    const app = initializeApp(FIREBASE_CONFIG);\n    db = fs.getFirestore(app);\n    loadAll();\n  } catch(e) { toast('Firebase non disponible'); }\n}\n\nasync function loadAll() {\n  try {\n    const snap = await fs.getDoc(fs.doc(db,'app_config','global'));\n    if (snap.exists()) {\n      const d = snap.data();\n      setVal('afg', d.annualFinancialGoal);\n      setVal('mfg', d.monthlyFinancialGoal);\n      setVal('fiscal-start', d.fiscalStart);\n      setVal('reward-soldout', d.rewardSoldout);\n      setVal('reward-game', d.rewardGame);\n      setVal('bonus-soldout', d.bonusSoldout);\n      setVal('bonus-best', d.bonusBest);\n    }\n  } catch(_) {}\n  loadCarts();\n  loadSuppliers();\n}\n\nasync function saveGoals() {\n  const data = {\n    annualFinancialGoal:  num('afg'),\n    monthlyFinancialGoal: num('mfg'),\n    fiscalStart:          val('fiscal-start'),\n    rewardSoldout:        num('reward-soldout'),\n    rewardGame:           num('reward-game'),\n    bonusSoldout:         num('bonus-soldout'),\n    bonusBest:            num('bonus-best'),\n  };\n  if (db) {\n    try { await fs.setDoc(fs.doc(db,'app_config','global'), data, {merge:true}); toast('\u2713 Objectifs sauvegard\u00e9s'); showBadge(); }\n    catch(e) { toast('Erreur: '+e.message); }\n  }\n}\n\nasync function addCart() {\n  const name   = val('cart-name').trim();\n  const cartId = val('cart-id').trim().replace(/\\s+/g,'_').toLowerCase();\n  if (!name || !cartId) { toast('\u26a0 Nom et identifiant requis'); return; }\n  const data = {\n    cartName: name,\n    dailyCAGoal:  num('cart-ca-goal')  || 50000,\n    dailyGoalCmd: num('cart-cmd-goal') || 30,\n    videoUrl: val('cart-video').trim(),\n  };\n  try {\n    const ref = fs.doc(db,'carts',cartId);\n    const exists = (await fs.getDoc(ref)).exists();\n    if (!exists) data.createdAt = fs.serverTimestamp();\n    await fs.setDoc(ref, data, {merge:true});\n    clear('cart-name'); clear('cart-id'); clear('cart-ca-goal'); clear('cart-cmd-goal'); clear('cart-video');\n    toast((exists?'\u2713 Chariot mis \u00e0 jour: ':'\u2713 Chariot ajout\u00e9: ')+name);\n    loadCarts();\n  } catch(e) { toast('Erreur: '+e.message); }\n}\n\nasync function loadCarts() {\n  const list = document.getElementById('carts-list');\n  if (!db) { list.innerHTML = '<div class=\"status-line\">Non connect\u00e9</div>'; return; }\n  try {\n    const snap = await fs.getDocs(fs.query(fs.collection(db,'carts'), fs.orderBy('createdAt','asc')));\n    if (snap.empty) { list.innerHTML = '<div class=\"status-line\">Aucun chariot enregistr\u00e9</div>'; return; }\n    const todayStr = new Date().toLocaleDateString('fr-FR');\n    let html = '';\n    for (const d of snap.docs) {\n      const data = d.data();\n      let todayCA = 0, todayOrders = 0;\n      try {\n        const oSnap = await fs.getDocs(fs.query(fs.collection(db,'carts',d.id,'orders'), fs.where('date','==',todayStr)));\n        oSnap.forEach(o => { todayCA += Number(o.data().total)||0; todayOrders++; });\n      } catch(_){}\n      html += `<div class=\"record-item\">\n        <div>\n          <div class=\"record-name\">${data.cartName||d.id}</div>\n          <div class=\"record-id\">${d.id} \u00b7 objectifs: ${(data.dailyCAGoal||0).toLocaleString('fr-FR')} FCFA / ${data.dailyGoalCmd||0} ventes</div>\n          <div class=\"record-stats\">Aujourd'hui: ${todayCA.toLocaleString('fr-FR')} FCFA \u00b7 ${todayOrders} commande(s)</div>\n        </div>\n        <button class=\"record-del\" onclick=\"deleteCart('${d.id}')\">\u2715</button>\n      </div>`;\n    }\n    list.innerHTML = html;\n  } catch(e) { list.innerHTML = '<div class=\"status-line\">Erreur: '+e.message+'</div>'; }\n}\n\nasync function deleteCart(id) {\n  if (!db) return;\n  if (!confirm) {} // pas de confirm() bloquant en WebView, suppression directe\n  try { await fs.deleteDoc(fs.doc(db,'carts',id)); loadCarts(); toast('Chariot supprim\u00e9'); } catch(e) { toast('Erreur: '+e.message); }\n}\n\nasync function addSupplier() {\n  const name = val('sup-name').trim();\n  if (!name) { toast('\u26a0 Nom du fournisseur requis'); return; }\n  const data = {\n    companyName: name, product: val('sup-product'), specifications: val('sup-spec'),\n    deliveryDelay: val('sup-delay'), quality: val('sup-quality'), unitPrice: num('sup-price'),\n    createdAt: fs.serverTimestamp(),\n  };\n  try {\n    await fs.addDoc(fs.collection(db,'suppliers'), data);\n    ['sup-name','sup-product','sup-spec','sup-delay','sup-quality','sup-price'].forEach(clear);\n    toast('\u2713 Fournisseur ajout\u00e9'); loadSuppliers();\n  } catch(e) { toast('Erreur: '+e.message); }\n}\n\nasync function loadSuppliers() {\n  const list = document.getElementById('suppliers-list');\n  if (!db) return;\n  try {\n    const snap = await fs.getDocs(fs.query(fs.collection(db,'suppliers'), fs.orderBy('createdAt','asc')));\n    if (snap.empty) { list.innerHTML = '<div class=\"status-line\">Aucun fournisseur</div>'; return; }\n    list.innerHTML = snap.docs.map(d => `\n      <div class=\"record-item\">\n        <div>\n          <div class=\"record-name\">${d.data().companyName}</div>\n          <div class=\"record-id\">${d.data().product||''} \u2014 ${(d.data().unitPrice||0).toLocaleString('fr-FR')} FCFA/u</div>\n        </div>\n        <button class=\"record-del\" onclick=\"deleteSupplier('${d.id}')\">\u2715</button>\n      </div>`).join('');\n  } catch(_) {}\n}\n\nasync function deleteSupplier(id) {\n  try { await fs.deleteDoc(fs.doc(db,'suppliers',id)); loadSuppliers(); toast('Fournisseur supprim\u00e9'); } catch(_) {}\n}\n\nfunction toggle(header) {\n  const body = header.nextElementSibling, arrow = header.querySelector('.section-arrow');\n  const open = body.classList.toggle('open');\n  header.classList.toggle('open', open);\n  arrow.classList.toggle('open', open);\n}\nfunction val(id){ return (document.getElementById(id)||{}).value || ''; }\nfunction num(id){ return parseFloat(val(id)) || 0; }\nfunction setVal(id,v){ const el=document.getElementById(id); if(el && v!==undefined) el.value=v; }\nfunction clear(id){ const el=document.getElementById(id); if(el) el.value=''; }\nfunction toast(msg){ const el=document.getElementById('toast'); el.textContent=msg; el.classList.add('show'); setTimeout(()=>el.classList.remove('show'),2400); }\nfunction showBadge(){ const b=document.getElementById('save-badge'); b.classList.add('show'); setTimeout(()=>b.classList.remove('show'),2000); }\n\ninit();\n</script>\n<script id=\"nav-bridge\">window._nav=function(url){var p=url.split('?'),page=p[0].replace('.html',''),search=p[1]||'',m=search.match(/id=([^&]+)/),param=m?decodeURIComponent(m[1]):'';try{(window.ReactNativeWebView||{postMessage:function(){}}).postMessage(JSON.stringify({action:'NAVIGATE',screen:page,param:param}));}catch(e){}};</script>\n</body>\n</html>\n"}
