{"h": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>Ninja's Corp \u2014 R\u00e9compenses</title>\n<style>\n  :root{--orange:#ff7a1a;--cyan:#00f2ff;--bg:#020810;--dark:#0a1525;--border:rgba(255,122,26,.3);}\n  *{margin:0;padding:0;box-sizing:border-box;}\n  body{background:var(--bg);color:#e8d8c0;font-family:'Share Tech Mono',monospace;height:100vh;display:flex;flex-direction:column;overflow:hidden;}\n  .header{display:flex;align-items:center;padding:10px 16px;border-bottom:1px solid var(--border);background:rgba(0,0,0,.8);gap:12px;flex-shrink:0;}\n  .back-btn{background:none;border:1px solid var(--orange);color:var(--orange);padding:6px 14px;font-family:inherit;font-size:14px;cursor:pointer;border-radius:2px;}\n  .header-title{flex:1;font-size:16px;font-weight:900;letter-spacing:2px;color:var(--orange);}\n  .scroll{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:12px;}\n  .scroll::-webkit-scrollbar{width:3px;} .scroll::-webkit-scrollbar-thumb{background:var(--border);}\n  .podium{display:flex;align-items:flex-end;justify-content:center;gap:8px;padding:16px 0;height:160px;}\n  .podium-place{display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;max-width:120px;}\n  .podium-block{width:100%;border-radius:3px 3px 0 0;display:flex;align-items:center;justify-content:center;font-size:20px;border:1px solid;}\n  .podium-place:nth-child(1) .podium-block{height:110px;background:rgba(255,200,0,.15);border-color:#ffd700;}\n  .podium-place:nth-child(2) .podium-block{height:80px;background:rgba(255,122,26,.12);border-color:var(--orange);}\n  .podium-place:nth-child(3) .podium-block{height:55px;background:rgba(0,242,255,.08);border-color:var(--cyan);}\n  .podium-name{font-size:10px;font-weight:900;letter-spacing:1px;text-align:center;}\n  .podium-val{font-size:9px;color:#667788;text-align:center;}\n  .podium-place:nth-child(1) .podium-name{color:#ffd700;}\n  .podium-place:nth-child(2) .podium-name{color:var(--orange);}\n  .podium-place:nth-child(3) .podium-name{color:var(--cyan);}\n  .medals-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}\n  .medal-card{background:var(--dark);border:1px solid var(--border);border-radius:3px;padding:12px;display:flex;gap:10px;align-items:center;}\n  .medal-card.gold{border-color:rgba(255,200,0,.4);} .medal-card.silver{border-color:rgba(200,200,220,.3);}\n  .medal-card.bronze{border-color:rgba(200,120,60,.3);} .medal-card.special{border-color:rgba(0,242,255,.3);}\n  .medal-icon{font-size:26px;flex-shrink:0;}\n  .medal-title{font-size:11px;font-weight:900;letter-spacing:.5px;margin-bottom:3px;}\n  .medal-card.gold .medal-title{color:#ffd700;} .medal-card.silver .medal-title{color:#c8c8dc;}\n  .medal-card.bronze .medal-title{color:#c87840;} .medal-card.special .medal-title{color:var(--cyan);}\n  .medal-holder{font-size:12px;font-weight:900;color:#e8d8c0;}\n  .medal-val{font-size:10px;color:#667788;margin-top:2px;}\n  .rank-table{background:var(--dark);border:1px solid var(--border);border-radius:3px;overflow:hidden;}\n  .rank-header{display:grid;grid-template-columns:30px 1fr 80px 70px 60px;padding:8px 12px;border-bottom:1px solid var(--border);font-size:10px;color:#667788;font-weight:900;}\n  .rank-row{display:grid;grid-template-columns:30px 1fr 80px 70px 60px;padding:9px 12px;border-bottom:1px solid rgba(255,122,26,.06);align-items:center;}\n  .rank-row:last-child{border-bottom:none;}\n  .rank-row.rank-1{background:rgba(255,200,0,.04);}\n  .rank-num{font-size:12px;font-weight:900;}\n  .rank-row.rank-1 .rank-num{color:#ffd700;} .rank-row.rank-2 .rank-num{color:#c8c8dc;} .rank-row.rank-3 .rank-num{color:#c87840;}\n  .rank-name{font-size:12px;font-weight:900;}\n  .rank-ca{font-size:11px;color:var(--orange);} .rank-cmd{font-size:11px;color:var(--cyan);}\n  .rank-badge{font-size:9px;padding:2px 6px;border-radius:2px;text-align:center;}\n  .rank-badge.sold{background:rgba(255,50,50,.2);color:#ff5555;border:1px solid rgba(255,50,50,.3);}\n  .rank-badge.top{background:rgba(0,242,255,.1);color:var(--cyan);border:1px solid rgba(0,242,255,.2);}\n  .rank-badge.ok{background:rgba(255,122,26,.1);color:var(--orange);border:1px solid rgba(255,122,26,.2);}\n  .obj-card{background:var(--dark);border:1px solid var(--border);border-radius:3px;padding:12px;}\n  .obj-card-title{font-size:10px;color:rgba(255,122,26,.7);letter-spacing:1px;font-weight:900;margin-bottom:10px;}\n  .obj-row{margin-bottom:10px;}\n  .obj-label{display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px;}\n  .obj-label span:first-child{color:#667788;}\n  .obj-bar{height:6px;background:rgba(255,255,255,.06);border-radius:3px;overflow:hidden;}\n  .obj-fill{height:100%;border-radius:3px;}\n  .obj-fill.gold{background:linear-gradient(90deg,#cc8800,#ffd700);}\n  .obj-fill.orange{background:linear-gradient(90deg,#ff4400,#ff8800);}\n  .obj-fill.cyan{background:linear-gradient(90deg,#0077ff,#00d4ff);}\n  .section-title-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}\n  .section-title{font-size:11px;font-weight:900;color:var(--orange);letter-spacing:1px;}\n  .period-badge{font-size:9px;color:#667788;border:1px solid var(--border);padding:2px 8px;border-radius:2px;}\n  .empty{text-align:center;padding:30px;color:#667788;font-size:12px;}\n</style>\n</head>\n<body>\n<div class=\"header\">\n  <button class=\"back-btn\" onclick=\"window._nav('dashboard.html')\">\u2039 Retour</button>\n  <div class=\"header-title\">\ud83c\udfc6 TABLEAU DE R\u00c9COMPENSES</div>\n</div>\n<div class=\"scroll\" id=\"scroll-content\">\n  <div class=\"empty\">Chargement des donn\u00e9es...</div>\n</div>\n\n<script>\nconst FIREBASE_CONFIG = { apiKey:\"AIzaSyDJS5sgI7rFyAQAOZNgJsZ1nkWwjFI-cDE\", projectId:\"ninja-s-fries\" };\nlet db, fs, goals = {};\n\nfunction parseFrDate(s){ if(!s) return null; const p=s.split('/'); return p.length===3 ? new Date(+p[2],+p[1]-1,+p[0]) : null; }\n\nasync function init() {\n  try {\n    const { initializeApp } = await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js');\n    fs = await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js');\n    const app = initializeApp(FIREBASE_CONFIG);\n    db = fs.getFirestore(app);\n\n    const gSnap = await fs.getDoc(fs.doc(db,'app_config','global'));\n    if (gSnap.exists()) goals = gSnap.data();\n\n    fs.onSnapshot(fs.query(fs.collection(db,'carts'), fs.orderBy('createdAt','asc')), async snap => {\n      const cartsRaw = snap.docs.map(d => ({ id:d.id, ...d.data() }));\n      await computeAndRender(cartsRaw);\n    });\n  } catch(e) {\n    document.getElementById('scroll-content').innerHTML = '<div class=\"empty\">Hors-ligne \u2014 '+e.message+'</div>';\n  }\n}\n\nasync function computeAndRender(cartsRaw) {\n  const todayStr = new Date().toLocaleDateString('fr-FR');\n  const fiscalDate = goals.fiscalStart ? new Date(goals.fiscalStart) : new Date(new Date().getFullYear(),0,1);\n  const carts = [];\n\n  for (const c of cartsRaw) {\n    let todayCA=0, todayOrders=0, annualTotal=0;\n    try {\n      const tSnap = await fs.getDocs(fs.query(fs.collection(db,'carts',c.id,'orders'), fs.where('date','==',todayStr)));\n      tSnap.forEach(d => { todayCA += Number(d.data().total)||0; todayOrders++; });\n    } catch(_){}\n    try {\n      const aSnap = await fs.getDocs(fs.query(fs.collection(db,'carts',c.id,'orders'), fs.orderBy('createdAt','desc'), fs.limit(3000)));\n      aSnap.forEach(d => { const od=parseFrDate(d.data().date); if (od && od>=fiscalDate) annualTotal += Number(d.data().total)||0; });\n    } catch(_){}\n    carts.push({ id:c.id, cartName:c.cartName||c.id, dailyCAGoal:c.dailyCAGoal||50000, dailyGoalCmd:c.dailyGoalCmd||30,\n                 todayTotal:todayCA, todayOrders, annualTotal });\n  }\n  render(carts);\n}\n\nfunction render(carts) {\n  if (!carts.length) {\n    document.getElementById('scroll-content').innerHTML = '<div class=\"empty\">Aucun chariot enregistr\u00e9 \u2014 ajoutez-en dans les Param\u00e8tres</div>';\n    return;\n  }\n  const sorted = [...carts].sort((a,b) => b.todayTotal - a.todayTotal);\n  const caGoal  = carts[0]?.dailyCAGoal  || 50000;\n  const soldoutThreshold = (goals.rewardSoldout || 100) / 100;\n  const afg = goals.annualFinancialGoal || 0;\n\n  const totalAnnual = carts.reduce((s,c)=>s+c.annualTotal,0);\n  const totalCA     = carts.reduce((s,c)=>s+c.todayTotal,0);\n  const totalCmd    = carts.reduce((s,c)=>s+c.todayOrders,0);\n  const annPct      = afg>0 ? Math.min(Math.round((totalAnnual/afg)*100),100) : 0;\n\n  const podiumCarts = sorted.slice(0,3);\n  const podiumEmojis = ['\ud83d\udc51','\ud83e\udd48','\ud83e\udd49'];\n  const podiumHtml = `\n    <div class=\"section-title-row\"><span class=\"section-title\">PODIUM DU JOUR</span><span class=\"period-badge\">${new Date().toLocaleDateString('fr-FR')}</span></div>\n    <div class=\"podium\">\n      ${[podiumCarts[1],podiumCarts[0],podiumCarts[2]].map((c,i) => c ? `\n        <div class=\"podium-place\" style=\"order:${i===1?0:i===0?1:2}\">\n          <div class=\"podium-block\">${podiumEmojis[i===1?0:i===0?1:2]}</div>\n          <div class=\"podium-name\">${c.cartName.toUpperCase()}</div>\n          <div class=\"podium-val\">${c.todayTotal.toLocaleString('fr-FR')} FCFA</div>\n        </div>` : '').join('')}\n    </div>`;\n\n  const bestCA  = sorted[0];\n  const bestCmd = [...carts].sort((a,b)=>b.todayOrders-a.todayOrders)[0];\n  const soldOut = carts.filter(c => c.todayTotal >= c.dailyCAGoal * soldoutThreshold);\n  const bestAnn = [...carts].sort((a,b)=>b.annualTotal-a.annualTotal)[0];\n\n  const medalsHtml = `\n    <div class=\"section-title-row\"><span class=\"section-title\">M\u00c9DAILLES</span></div>\n    <div class=\"medals-grid\">\n      <div class=\"medal-card gold\"><div class=\"medal-icon\">\ud83c\udfc6</div><div>\n        <div class=\"medal-title\">RECORD DESTROYER</div>\n        <div class=\"medal-holder\">${bestCA.cartName.toUpperCase()}</div>\n        <div class=\"medal-val\">${bestCA.todayTotal.toLocaleString('fr-FR')} FCFA</div></div></div>\n      <div class=\"medal-card silver\"><div class=\"medal-icon\">\u26a1</div><div>\n        <div class=\"medal-title\">GAME CHANGER</div>\n        <div class=\"medal-holder\">${bestCmd.cartName.toUpperCase()}</div>\n        <div class=\"medal-val\">${bestCmd.todayOrders} ventes</div></div></div>\n      <div class=\"medal-card bronze\"><div class=\"medal-icon\">\ud83d\udd25</div><div>\n        <div class=\"medal-title\">SOLD OUT \u00d7${soldOut.length}</div>\n        <div class=\"medal-holder\">${soldOut.length ? soldOut.map(c=>c.cartName.toUpperCase()).join(', ') : 'Aucun'}</div>\n        <div class=\"medal-val\">+${(goals.bonusSoldout||5000).toLocaleString('fr-FR')} FCFA/cart</div></div></div>\n      <div class=\"medal-card special\"><div class=\"medal-icon\">\u2b50</div><div>\n        <div class=\"medal-title\">BEST CART (CUMUL)</div>\n        <div class=\"medal-holder\">${bestAnn.cartName.toUpperCase()}</div>\n        <div class=\"medal-val\">${bestAnn.annualTotal.toLocaleString('fr-FR')} FCFA</div></div></div>\n    </div>`;\n\n  const rankHtml = `\n    <div class=\"section-title-row\"><span class=\"section-title\">CLASSEMENT COMPLET</span></div>\n    <div class=\"rank-table\">\n      <div class=\"rank-header\"><span>#</span><span>CHARIOT</span><span>C.A.</span><span>VENTES</span><span>STATUT</span></div>\n      ${sorted.map((c,i) => {\n        const caPct = Math.min(Math.round((c.todayTotal/(c.dailyCAGoal||1))*100),100);\n        const isSold = c.todayTotal >= c.dailyCAGoal*soldoutThreshold;\n        const badge = isSold ? '<span class=\"rank-badge sold\">SOLD OUT</span>'\n                    : caPct>=85 ? '<span class=\"rank-badge top\">TOP</span>'\n                    : '<span class=\"rank-badge ok\">'+caPct+'%</span>';\n        return `<div class=\"rank-row rank-${i+1}\">\n          <span class=\"rank-num\">${i+1}</span><span class=\"rank-name\">${c.cartName.toUpperCase()}</span>\n          <span class=\"rank-ca\">${c.todayTotal.toLocaleString('fr-FR')}</span>\n          <span class=\"rank-cmd\">${c.todayOrders}</span><span>${badge}</span></div>`;\n      }).join('')}\n    </div>`;\n\n  const totalCAPct  = carts.length ? Math.min(Math.round((totalCA /(caGoal*carts.length))*100),100) : 0;\n  const totalCmdPct = carts.length ? Math.min(Math.round((totalCmd/((carts[0]?.dailyGoalCmd||30)*carts.length))*100),100) : 0;\n  const objHtml = `\n    <div class=\"obj-card\">\n      <div class=\"obj-card-title\">\ud83d\udcca PROGRESSION GLOBALE</div>\n      <div class=\"obj-row\"><div class=\"obj-label\"><span>Objectif annuel (AFG)</span><span style=\"color:#ffd700\">${annPct}%</span></div>\n        <div class=\"obj-bar\"><div class=\"obj-fill gold\" style=\"width:${annPct}%\"></div></div></div>\n      <div class=\"obj-row\"><div class=\"obj-label\"><span>C.A. journalier global</span><span style=\"color:var(--orange)\">${totalCAPct}%</span></div>\n        <div class=\"obj-bar\"><div class=\"obj-fill orange\" style=\"width:${totalCAPct}%\"></div></div></div>\n      <div class=\"obj-row\"><div class=\"obj-label\"><span>Commandes journalier global</span><span style=\"color:var(--cyan)\">${totalCmdPct}%</span></div>\n        <div class=\"obj-bar\"><div class=\"obj-fill cyan\" style=\"width:${totalCmdPct}%\"></div></div></div>\n    </div>`;\n\n  document.getElementById('scroll-content').innerHTML = podiumHtml + medalsHtml + rankHtml + objHtml;\n}\n\ninit();\n</script>\n<script id=\"nav-bridge\">window._nav=function(url){var p=url.split('?'),page=p[0].replace('.html',''),search=p[1]||'',m=search.match(/id=([^&]+)/),param=m?decodeURIComponent(m[1]):'';try{(window.ReactNativeWebView||{postMessage:function(){}}).postMessage(JSON.stringify({action:'NAVIGATE',screen:page,param:param}));}catch(e){}};</script>\n</body>\n</html>\n"}
